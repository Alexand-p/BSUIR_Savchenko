@model HomeFormModel
@{
    ViewData["Title"] = "Контрольная работа №1";
}
<h1>Контрольная работа №1</h1>

@if (ViewBag.Message is string notice)
{
    <p class="message">@notice</p>
}

<form asp-controller="Home" asp-action="Index" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label for="SelectedItem">Элемент списка</label>
    <select asp-for="SelectedItem">
        <option value="item1">Item 1</option>
        <option value="item2">Item 2</option>
        <option value="item3">Item 3</option>
    </select>

    <label class="check"><input asp-for="CheckOne" /> Чек-бокс 1</label>
    <label class="check"><input asp-for="CheckTwo" /> Чек-бокс 2</label>

    <div class="radios">
        <label><input type="radio" asp-for="RadioOption" value="radio1" /> Радио-1</label>
        <label><input type="radio" asp-for="RadioOption" value="radio2" /> Радио-2</label>
        <label><input type="radio" asp-for="RadioOption" value="radio3" /> Радио-3</label>
    </div>

    <label asp-for="Email">Логин</label>
    <input asp-for="Email" placeholder="user@gmail.com" />
    <span asp-validation-for="Email" class="error"></span>

    <label asp-for="Password">Пароль</label>
    <input asp-for="Password" />
    <span asp-validation-for="Password" class="error"></span>

    <button type="submit">Отправить</button>
</form>
