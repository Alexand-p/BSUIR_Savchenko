@page
@model BSUIR_Savchenko.UI.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Администрирование";
}
<div class="page-heading">
    <h1>Администрирование каталога</h1>
    <a class="button" asp-area="Admin" asp-page="/Create">Добавить книгу</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="error">@Model.Error</p>
}
else
{
    <div class="table-scroll">
        <table class="admin-table">
            <thead>
                <tr><th>Изображение</th><th>Книга</th><th>Категория</th><th>Цена</th><th>Действия</th></tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td><img src="@Model.ImageUrl(book)" alt="" /></td>
                        <td>@book.Name</td>
                        <td>@(book.Category?.Name)</td>
                        <td>@(book.Price.ToString("N2")) руб.</td>
                        <td class="actions">
                            <a asp-area="Admin" asp-page="/Edit" asp-route-id="@book.Id">Изменить</a>
                            <a asp-area="Admin" asp-page="/Delete" asp-route-id="@book.Id">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav class="pagination" aria-label="Страницы списка">
        @for (int page = 1; page <= Model.TotalPages; page++)
        {
            <a class="@(page == Model.CurrentPage ? "active" : "")"
               asp-area="Admin" asp-page="/Index" asp-route-pageNo="@(page)">@(page)</a>
        }
    </nav>
}
