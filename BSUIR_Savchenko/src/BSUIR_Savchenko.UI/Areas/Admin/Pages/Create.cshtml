@page
@model BSUIR_Savchenko.UI.Areas.Admin.Pages.CreateModel
@{
    ViewData["Title"] = "Добавление книги";
}
<h1>Добавление книги</h1>
<form method="post" enctype="multipart/form-data" class="form editor-form">
    <div asp-validation-summary="All" class="error"></div>
    <label asp-for="Input.Name"></label>
    <input asp-for="Input.Name" />
    <label asp-for="Input.Description"></label>
    <textarea asp-for="Input.Description" rows="4"></textarea>
    <label asp-for="Input.CategoryId"></label>
    <select asp-for="Input.CategoryId" asp-items="Model.Categories"><option value="0">Выберите категорию</option></select>
    <label asp-for="Input.Price"></label>
    <input asp-for="Input.Price" type="number" step="0.01" min="0.01" />
    <label asp-for="ImageFile">Изображение (необязательно)</label>
    <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" />
    <div class="form-actions"><button type="submit">Сохранить</button><a asp-page="/Index">Отмена</a></div>
</form>
